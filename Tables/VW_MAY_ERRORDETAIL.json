  "ExternalDatabaseInfo": {
    "DataBaseType": "6db454c0-531c-4395-9122-921a18942902",
    "ConnectionId": "Oracle3",
    "SourceTableName": "VW_MAY_ERRORDETAIL",
    "SourceTableSchema": "",
    "CreateViewSql": "SELECT\n    ERRORCODE,\n    DEPARTMENTID,\n    STYLE,\n    -- Th?m c?t DATE_TIME (ng?y c?a INSERTDATETIME)\n    TRUNC(INSERTDATETIME) AS DATETIME,\n    -- TIME1: T? 7:30 d?n 9:30\n    SUM(CASE\n            WHEN TO_CHAR(INSERTDATETIME, 'HH24:MI:ss') BETWEEN '07:30:01' AND '09:30:00'\n            THEN SOLUONG\n            ELSE null\n        END) AS TIME1,\n    -- TIME2: T? 9:30 d?n 11:30\n    SUM(CASE\n            WHEN TO_CHAR(INSERTDATETIME, 'HH24:MI:ss') BETWEEN '09:30:01' AND '11:30:00'\n            THEN SOLUONG\n            ELSE null\n        END) AS TIME2,\n    -- TIME3: T? 11:30 d?n 14:30\n    SUM(CASE\n            WHEN TO_CHAR(INSERTDATETIME, 'HH24:MI:ss') BETWEEN '11:30:01' AND '14:30:00'\n            THEN SOLUONG\n            ELSE null\n        END) AS TIME3,\n    -- TIME4: T? 14:30 d?n 16:30\n    SUM(CASE\n            WHEN TO_CHAR(INSERTDATETIME, 'HH24:MI:ss') BETWEEN '14:30:01' AND '16:30:00'\n            THEN SOLUONG\n            ELSE null\n        END) AS TIME4,\n    -- TIME5: T? 16:30 d?n 18:30\n    SUM(CASE\n            WHEN TO_CHAR(INSERTDATETIME, 'HH24:MI:ss') BETWEEN '16:30:01' AND '18:30:00'\n            THEN SOLUONG\n            ELSE null\n        END) AS TIME5,\n    -- TIME6: T? 18:30 d?n 20:30\n    SUM(CASE\n            WHEN TO_CHAR(INSERTDATETIME, 'HH24:MI:ss') BETWEEN '18:30:01' AND '20:30:00'\n            THEN SOLUONG\n            ELSE null\n        END) AS TIME6,\n    -- SUM_TOTAL: T?ng c?a t?t c? c?c TIME\n    SUM(CASE\n            WHEN TO_CHAR(INSERTDATETIME, 'HH24:MI:ss') BETWEEN '07:30:01' AND '20:30:00' THEN SOLUONG\n            ELSE null\n        END) AS SUM_TOTAL\nFROM may_errordetailtest\nwhere SOLUONG > 0\nGROUP BY ERRORCODE, DEPARTMENTID, STYLE, TRUNC(INSERTDATETIME)\n",
    "ViewInfo": {
