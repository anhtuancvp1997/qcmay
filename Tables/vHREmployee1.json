  "ExternalDatabaseInfo": {
    "DataBaseType": "6db454c0-531c-4395-9122-921a18942902",
    "ConnectionId": "SqlServer1",
    "SourceTableName": "vHREmployee",
    "SourceTableSchema": "dbo",
    "CreateViewSql": "SELECT E.EmpNo, E.EmpName, E.DeptCode, D.DeptName, D.DeptSName_C, D.DeptSName_L\r\n\t\t, E.TypeJobId, J.TJobName_C, J.TJobName_L, E.TypeWorkId, W.TWorkName_C, W.TWorkName_L\r\n\t\t, E.TypeSexId, C1.PubName_C AS SexName_C, C1.PubSName_L AS SexName_L, E.InDate, E.IsAtdCal, C2.PubSName_C, C2.PubSName_L\r\n\t\t, E.FacCode, F.FacName_C, F.FacName_L\r\n\tFROM HREmployee E \r\n\t\tINNER JOIN HRSDept D ON E.DeptCode = D.DeptCode\r\n\t\tINNER JOIN HRETypeJob J ON E.TypeJobId = J.TypeJobId\r\n\t\tLEFT OUTER JOIN HRETypeWork W ON E.TypeWorkId = W.TypeWorkId\r\n\t\tLEFT OUTER JOIN HRSFactory F ON E.FacCode = F.FacCode\r\n\t\tLEFT OUTER JOIN HRSPublic C1 ON E.TypeSexId = C1.PubId\r\n\t\tLEFT OUTER JOIN HRSPublic C2 ON E.IsAtdCal = C2.PubId\r\n\tWHERE E.OffDate IS NULL",
    "ViewInfo": {
      "ViewName": "vHREmployee",
      "IsUpdatable": true,
      "QueryColumns": [
        "EmpNo",
        "DeptCode"
      ]
    }
  },
